# MediGuide NextGen - Backend Environment Variables

# Server Configuration
PORT=5000
NODE_ENV=development
# Set to production on Render

# Database Configuration
MONGO_URI=mongodb://localhost:27017/mediaguide-nextgen
# OR if using MongoDB Atlas:
# MONGO_URI=mongodb+srv://username:password@cluster-name.mongodb.net/mediaguide-nextgen?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_EXPIRE=7d

# Email Configuration (Optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# AI/NLP Configuration (Optional)
AI_MODEL_TYPE=rule-based
# For future expansion: openai, huggingface, etc.

# File Upload
MAX_FILE_SIZE=5242880  # 5MB in bytes
UPLOAD_DIR=./uploads

# CORS Configuration
CORS_ORIGIN=http://localhost:4200,http://localhost:3000,http://localhost:3001
# Production example (comma-separated, no spaces):
# CORS_ORIGIN=https://medi-guide-eight.vercel.app,https://medi-guide-doctors-app.vercel.app,https://medi-guide-admin-app.vercel.app

# If frontend is deployed separately (Vercel), keep backend static serving disabled on Render
SERVE_FRONTEND_ASSETS=false

# API Rate Limiting
RATE_LIMIT_WINDOW=15  # minutes
RATE_LIMIT_MAX_REQUESTS=100  # per window

# Demo Mode (Set to false to use MongoDB)
DEMO_MODE=false

# Logging
LOG_LEVEL=debug
